# Debian x86_64 buildserver equivalent. APT supplies host tools only;
# Android runtime dependencies are compiled by the locked source recipes.
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
COPY install-debian-build-deps.sh setup-system-shim.sh /ci/
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    if [ -s /run/secrets/proxy_ca ]; then \
      export CURL_CA_BUNDLE=/run/secrets/proxy_ca; \
      export SSL_CERT_FILE=/run/secrets/proxy_ca; \
      export APT_CONFIG=/tmp/agentcodi-apt.conf; \
      printf 'Acquire::https::CaInfo "/run/secrets/proxy_ca";\n' > "$APT_CONFIG"; \
    fi; \
    bash /ci/install-debian-build-deps.sh \
    && bash /ci/setup-system-shim.sh \
    && useradd --create-home --uid 1001 builder \
    && rm -rf /var/lib/apt/lists/* /tmp/agentcodi-apt.conf
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
ENV RUSTUP_HOME=/workspace/.cache/runtime-source/rustup
ENV CARGO_HOME=/workspace/.cache/cargo
ENV V8_SYSTEM_LIBCLANG_DIR=/usr/lib/llvm-21/lib
ENV ANDROID_HOME=/opt/android-sdk
WORKDIR /workspace
USER builder
